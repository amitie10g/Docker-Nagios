--- a/nagioscore/html/stylesheets/common.css
+++ b/nagioscore/html/stylesheets/common.css
@@ -336,4 +336,38 @@
 a img {
 	border: none;
 	}
+
+.nagios-masonry {
+    width: 100%;
+    column-count: 4;
+    column-gap: 2%;
+    column-fill: balance;
+}
+
+.nagios-masonry-card {
+    display: inline-block;
+    width: 100%;
+    box-sizing: border-box;
+    margin: 0 0 18px 0;
+    vertical-align: top;
+    break-inside: avoid;
+    -webkit-column-break-inside: avoid;
+}
+
+.nagios-masonry-card table.status {
+    width: 100%;
+    box-sizing: border-box;
+}
+
+@media screen and (max-width: 1200px) {
+    .nagios-masonry { column-count: 3; }
+}
+
+@media screen and (max-width: 800px) {
+    .nagios-masonry { column-count: 2; }
+}
+
+@media screen and (max-width: 500px) {
+    .nagios-masonry { column-count: 1; }
+}

